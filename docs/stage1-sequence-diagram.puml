@startuml stage1-sequence-diagram
mainframe sd PlayRestaurantRush
title Stage 1 (tag: stage-1), base setting. Scenario: Customer #3 (Pasta) from arrival on turn 7 to payment, and the manager's turn-10 choice\nEvery message is a call in src/ (GameController, TurnMgr, Waiter, Chef, Cashier, Restaurant)

hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
skinparam ParticipantPadding 6
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor #2F3B45
  LifeLineBorderColor #8A97A6
  LifeLineBackgroundColor #E8EEF3
  ParticipantBorderColor #2F3B45
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #2F3B45
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #2F3B45
  GroupBackgroundColor #F4F6F8
  DividerBackgroundColor #E2EFE9
  DividerBorderColor #1E6B52
}
skinparam note {
  BackgroundColor #FFF6D9
  BorderColor #C9A227
}

actor Manager
boundary "ui : ConsoleUI" as V
control ":GameController" as GC
control "turnMgr : TurnMgr" as TP
entity "config : GameConfig" as CFG
entity ":ArrivalSchedule" as AS
entity ":Restaurant" as R
entity ":WaitingQueue" as Q
entity "w : Waiter" as W
entity "chef : Chef" as CH
entity "cashier : Cashier" as CA
entity "t : Table" as T
entity ":Menu" as M
entity "sb : Scoreboard" as SB
entity ":Objective" as OB

[o-> GC ++ : run()
note right of GC : found message:\nsent by RestaurantRushApp.main()
note left of GC : Shown: every call that changes state, makes a\ndecision or passes a value used later.\nOmitted: getters used only to build display\ntext (getName, getId, getTypeName, Money.format).

loop turn <= config.getMaxTurns()  (18 turns, no early end)
  GC -> CFG : maxTurns = getMaxTurns()
  GC -> GC ++ : playTurn(turn)
  GC -> R ++ : startTurn()
  R -> W : startTurn()
  R -> CH : startTurn()
  R -> CA : startTurn()
  return

  == Step 1 · Arrivals, then the start-of-turn display ==
  GC -> TP ++ : arrivalEvents = processArrivals(turn)
  TP -> AS ++ : arrivals = createArrivals(turn)
  opt a factory is registered for this turn (1, 4, 7, 10, 13, 16)
    create entity "c : RegularCustomer" as C
    AS -->> C : «create» factory.apply(nextCustomerId, turn)\n= RegularCustomer::new
    note right of C : turn 7: Customer #3\nsatisfaction 100, WAITING
  end
  return arrivals
  loop for each c : arrivals
    TP -> R ++ : admit(c)
    R -> Q : join(c)
    return
  end
  return arrivalEvents
  GC -> V ++ : showTurnStart(turn, maxTurns, restaurant)
  V -> Manager : turn, revenue, avg satisfaction, queue, tables,\nsatisfaction, order status, staff tasks available
  note right of V : reads state through getters only\n(getScoreboard, getWaitingQueue, getTables,\ngetAssignableStaff, getAvailableTasks)
  return
  loop for each e : arrivalEvents
    GC -> V : showMessage(e)
  end

  == Steps 2–3 · Waiter acts first ==
  GC -> R : staffList = getAssignableStaff()
  note right of GC : for (Assignable staff : staffList) assignTask(staff, turn)\nstaffList = [w, chef], so the loop is drawn unrolled:\niteration 1 = w (Waiter acts first), iteration 2 = chef
  GC -> GC ++ : assignTask(w, turn)
  GC -> W ++ : options = getAvailableTasks(restaurant)
  return options
  loop not accepted
    GC -> V ++ : task = askTask(w, options)
    V -> Manager : "Waiter options: ..."  "Waiter> "
    Manager -> V : e.g. "serve 3"
    V -> V : task = parseTask(line)
    note right of V : badly formed text is re-prompted here\n(NumberFormatException, IllegalArgumentException);\nrule checks are left to the domain
    return task
    GC -> W ++ : msg = perform(task, restaurant, turn)
    W -> W : ensureCanAct()
    alt task.getType() == SEAT
      W -> W ++ : seat(id, restaurant)
      W -> R : q = getWaitingQueue()
      W -> Q : c = findById(id)
      alt not in queue
        W --> GC : InvalidActionException(reason)
      else else
        W -> R : t = findFreeTable()
        alt no free table
          W --> GC : InvalidActionException(reason)
        else else
          W -> R ++ : seat(c, t)
          R -> Q : remove(c)
          R -> T : seat(c)
          R -> C : seatAt(t)
          note right of C : turn 7: SEATED at table 1
          return
        end
      end
      deactivate W
    else task.getType() == TAKE_ORDER
      W -> W ++ : takeOrder(id, restaurant)
      W -> R : c = findSeatedCustomer(id)
      alt not seated
        W --> GC : InvalidActionException(reason)
      else else
        W -> C : status = getStatus()
        alt status != SEATED (already ordered)
          W --> GC : InvalidActionException(reason)
        else else
          W -> R : menu = getMenu()
          W -> C ++ : item = chooseMenuItem(menu)
          C -> M : n = size()
          C -> M : item = getItem((getId() - 1) % n)
          note right of C : turn 8: (3 - 1) % 3 = 2 → Pasta
          return item
          W -> C : bill = calculateBillCents(item)
          create entity "o : Order" as O
          W -->> O : «create» Order(c.getId(), c, item, bill)
          note right of O : PLACED, 0/2 units,\nbill 1800 cents locked
          W -> C : placeOrder(o)
          W -> R : addOrder(o)
        end
      end
      deactivate W
    else task.getType() == SERVE
      W -> W ++ : serve(id, restaurant, turn)
      W -> R : o = findOrder(id)
      alt order not found
        W --> GC : InvalidActionException(reason)
      else else
        W -> O : ready = isReady()
        alt !ready
          W -> O : getRemainingUnits()
          W --> GC : InvalidActionException("Order #3 is not READY (1/2 units). ...")
        else else
          W -> O : markServed()
          W -> O : c = getCustomer()
          W -> C : receiveFood(turn)
          W -> R : sb = getScoreboard()
          W -> SB : recordServed()
          note right of W #E2EFE9 : <b>Manager choice, turn 10</b>\nA: "serve 3" → Customer #3 stops losing\nsatisfaction (76), pays turn 12 → VICTORY 5 paid\nB: "seat 4" instead → #3 falls to 60 and the\ndelay cascades → VICTORY at the 4-paid minimum\n(scripts/victory.txt vs scripts/seat-first.txt)
        end
      end
      deactivate W
    else task.getType() == WAIT
      note over W : no state change; message "Waiter waits this turn."
    else task.getType() == PREPARE
      W --> GC : InvalidActionException("The Waiter cannot cook. ...")
    end
    alt perform() threw InvalidActionException
      note over GC, W : the exception leaves perform() at once:\nmarkActed() is never reached, so the Waiter's task is NOT used up
      GC -> V : showError(e.getMessage())
      V -> Manager : "Not allowed: ... Choose again."
      note right of V : turn 9: "serve 3" is rejected (order 1/2 units);\nthe loop asks again and the manager types "wait"
    else else (perform() returned normally)
      W -> W : markActed()
      W --> GC : msg
      GC -> V : showMessage(msg)
      note over GC : accepted = true
    end
    deactivate W
  end
  deactivate GC

  == Steps 2–3 · Chef acts second (may cook an order taken this turn) ==
  GC -> GC ++ : assignTask(chef, turn)
  GC -> CH ++ : options = getAvailableTasks(restaurant)
  return options
  loop not accepted
    GC -> V ++ : task = askTask(chef, options)
    V -> Manager : "Chef options: ..."  "Chef> "
    Manager -> V : e.g. "cook 3"
    V -> V : task = parseTask(line)
    return task
    GC -> CH ++ : msg = perform(task, restaurant, turn)
    CH -> CH : ensureCanAct()
    alt task.getType() == PREPARE
      CH -> CH ++ : prepare(id, restaurant)
      CH -> R : o = findOrder(id)
      alt order not found
        CH --> GC : InvalidActionException(reason)
      else else
        CH -> O : cookable = isCookable()
        alt !cookable (READY, SERVED, CANCELLED)
          CH --> GC : InvalidActionException(reason)
        else else
          CH -> O ++ : advancePreparation()
          O -> O : isCookable()
          note right of O : !cookable → IllegalStateException\n(a programming error; the Chef already checked)
          opt unitsCompleted == item.getPreparationUnits()
            O -> O : status = READY
            note right of O : turn 8: 1/2 PREPARING\nturn 9: 2/2 READY
          end
          return
        end
      end
      deactivate CH
    else task.getType() == WAIT
      note over CH : no state change; "Chef waits this turn."
    else other task types (SEAT, TAKE_ORDER, SERVE)
      CH --> GC : InvalidActionException("The Chef can only cook or wait.")
    end
    alt perform() threw InvalidActionException
      note over GC, CH : markActed() is never reached: the Chef's task is not used up
      GC -> V : showError(e.getMessage())
      V -> Manager : "Not allowed: ... Choose again."
    else else (perform() returned normally)
      CH -> CH : markActed()
      CH --> GC : msg
      GC -> V : showMessage(msg)
      note over GC : accepted = true
    end
    deactivate CH
  end
  deactivate GC

  == Step 4 · Eating, then payment ==
  GC -> TP ++ : events = processEatingAndPayment(turn)
  TP -> R : seated = getSeatedCustomers()
  note right of R : returns a new list, so customers can be\nremoved while looping (no ConcurrentModificationException)
  loop for each c : seated
    TP -> C : done = finishEatingIfDone(turn)
    note right of C : EATING and servedTurn < turn\n→ READY_TO_PAY (turn 11)
  end
  TP -> R : cashier = getCashier()
  TP -> CA ++ : paid = processPayment(restaurant, turn)
  CA -> CA : acted = hasActedThisTurn()
  opt !acted
    CA -> R : seated = getSeatedCustomers()
    loop for each c : seated
      CA -> C : ok = canPay(turn)
      opt ok and oldest != null
        CA -> CA : older = isOlder(c, oldest)
        note right of CA : older = earlier readyToPayTurn,\nthen lower customer number
      end
      opt ok and (oldest == null or older)
        note over CA : oldest = c
      end
    end
    opt oldest found (READY_TO_PAY on an earlier turn)
      CA -> C : o = getOrder()
      CA -> O : bill = getBillCents()
      CA -> O : markPaid()
      CA -> C : markPaid()
      CA -> R : sb = getScoreboard()
      CA -> SB : recordPayment(bill, oldest.getSatisfaction())
      note right of SB : turn 12: revenue += 1800,\nsatisfaction 76 recorded
      CA -> R ++ : removeCustomer(oldest)
      R -> Q : remove(c)
      R -> C : t = getTable()
      R -> T : occupant = getOccupant()
      opt occupant == c
        R -> T : release()
      end
      R -> C : getOrder()
      note right of R : order dropped from activeOrders
      return
      CA -> CA : markActed()
    end
  end
  return paid
  return events

  == Step 5 · Waiting and abandonment ==
  GC -> TP ++ : more = processWaiting()
  TP -> R : q = getWaitingQueue()
  TP -> Q : waiting = getCustomers()
  TP -> R : seated = getSeatedCustomers()
  loop for each c : waiting + seated
    TP -> C : awaiting = isAwaitingService()
    opt awaiting (WAITING, SEATED or ORDERED)
      TP -> C ++ : applyWaitingPenalty()
      C -> C : loss = getSatisfactionLossPerTurn()
      note right of C : dynamically bound:\nRegularCustomer returns 8;\nsatisfaction never below 0
      return
      TP -> C : gone = hasRunOutOfPatience()
      opt gone (satisfaction == 0)
        TP -> TP ++ : handleDeparture(c)
        TP -> C : leave()
        TP -> C : getOrder()
        opt c has an order
          TP -> O : cancel()
        end
        TP -> R : removeCustomer(c)
        TP -> R : sb = getScoreboard()
        TP -> SB : recordDeparture()
        deactivate TP
      end
    end
  end
  return more

  loop for each e : events of steps 4 and 5
    GC -> V : showMessage(e)
  end
  GC -> R : sb = getScoreboard()
  GC -> V ++ : showTurnEnd(turn, maxTurns, sb)
  V -> Manager : served, departures, revenue,\navg satisfaction (or N/A), turns used
  return
  deactivate GC
end

== Step 6 · Result check after turn 18 ==
GC -> R : sb = getScoreboard()
GC -> CFG : objective = getObjective()
GC -> OB ++ : result = evaluate(sb)
OB -> SB : paid = getPaidCount()
OB -> SB : revenue = getRevenueCents()
OB -> SB : avg = getAverageSatisfaction()
alt paid >= 4 and revenue >= 4500 and avg present and avg >= 60
  OB --> GC : VICTORY
else else
  OB --> GC : DEFEAT
end
deactivate OB
GC -> V ++ : showFinalResult(result, sb, objective)
V -> Manager : "RESULT: VICTORY  5 paid, $66.00, 79.2"
return
[<-- GC -- : result
@enduml
