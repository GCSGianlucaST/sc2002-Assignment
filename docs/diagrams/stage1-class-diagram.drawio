ign=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1221" y="189" width="86" height="14" as="geometry"/></mxCell><mxCell id="c45" value="objective  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1339" y="76" width="57" height="14" as="geometry"/></mxCell><mxCell id="c46" value="menu  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1633" y="926" width="42" height="14" as="geometry"/></mxCell><mxCell id="c47" value="&amp;laquo;use&amp;raquo;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1613" y="77" width="33" height="14" as="geometry"/></mxCell><mxCell id="c48" value="scoreboard  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="316" y="699" width="67" height="14" as="geometry"/></mxCell><mxCell id="c49" value="tables  1..*  {ordered}" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="594" y="584" width="100" height="14" as="geometry"/></mxCell><mxCell id="c50" value="waitingQueue  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="776" y="584" width="78" height="14" as="geometry"/></mxCell><mxCell id="c51" value="waiter  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1408" y="771" width="44" height="14" as="geometry"/></mxCell><mxCell id="c52" value="chef  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1686" y="744" width="36" height="14" as="geometry"/></mxCell><mxCell id="c53" value="cashier  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="2000" y="730" width="49" height="14" as="geometry"/></mxCell><mxCell id="c54" value="menu  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1632" y="884" width="42" height="14" as="geometry"/></mxCell><mxCell id="c55" value="activeOrders  0..*  {ordered}" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1190" y="884" width="130" height="14" as="geometry"/></mxCell><mxCell id="c56" value="&amp;laquo;use&amp;raquo;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1296" y="396" width="33" height="14" as="geometry"/></mxCell><mxCell id="c57" value="&amp;laquo;use&amp;raquo;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1268" y="524" width="33" height="14" as="geometry"/></mxCell><mxCell id="c58" value="table  0..1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="581" y="715" width="50" height="14" as="geometry"/></mxCell><mxCell id="c59" value="occupant  0..1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="581" y="794" width="69" height="14" as="geometry"/></mxCell><mxCell id="c60" value="customers  0..*  {ordered}" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="718" y="794" width="119" height="14" as="geometry"/></mxCell><mxCell id="c61" value="customer  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="846" y="906" width="58" height="14" as="geometry"/></mxCell><mxCell id="c62" value="order  0..1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="994" y="906" width="52" height="14" as="geometry"/></mxCell><mxCell id="c63" value="item  1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1420" y="1134" width="36" height="14" as="geometry"/></mxCell><mxCell id="c64" value="items  1..*  {ordered}" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;labelBackgroundColor=#ffffff;resizable=0;" vertex="1" parent="1"><mxGeometry x="1505" y="1084" width="97" height="14" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;status and unitsCompleted are private and change only through advancePreparation(), markServed(), markPaid() and cancel(), each of which refuses an illegal move (e.g. serving before READY)." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#B8A44C;fontSize=10;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1210" y="1170" width="235" height="104" as="geometry"/></mxCell><mxCell id="e66" value="" style="html=1;fontSize=10;fontFamily=Arial;rounded=0;endSize=10;startSize=14;endArrow=none;dashed=1;strokeColor=#9E9E9E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1170" as="sourcePoint"/><mxPoint x="1300" y="1121" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c67" value="&lt;b&gt;Polymorphism&lt;/b&gt;&lt;br&gt;Customer is abstract: getSatisfactionLossPerTurn(), getTypeName() and chooseMenuItem() are abstract. TurnMgr, Waiter and Cashier call them on any Customer without checking its type; the subclass answers (dynamic binding)." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#B8A44C;fontSize=10;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="560" y="1310" width="380" height="79" as="geometry"/></mxCell><mxCell id="e68" value="" style="html=1;fontSize=10;fontFamily=Arial;rounded=0;endSize=10;startSize=14;endArrow=none;dashed=1;strokeColor=#9E9E9E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="1330" as="sourcePoint"/><mxPoint x="533" y="1330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="&lt;b&gt;Composition&lt;/b&gt;&lt;br&gt;Restaurant's constructor creates its Tables, WaitingQueue, Waiter, Chef, Cashier and Scoreboard; they do not exist without it." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#B8A44C;fontSize=10;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="245" height="79" as="geometry"/></mxCell><mxCell id="e70" value="" style="html=1;fontSize=10;fontFamily=Arial;rounded=0;endSize=10;startSize=14;endArrow=none;dashed=1;strokeColor=#9E9E9E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="890" as="sourcePoint"/><mxPoint x="170" y="841" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value="&lt;b&gt;DIP&lt;/b&gt;: GameController depends on the GameUI interface, not the console; RestaurantRushApp plugs in ConsoleUI (the tests plug in a scripted UI).&lt;br&gt;&lt;b&gt;ISP / OCP&lt;/b&gt;: only manager-directed staff implement Assignable (the Cashier acts automatically). GameController.assignTask() works on any Assignable." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#B8A44C;fontSize=10;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1650" y="228" width="520" height="79" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;Notation (CE/CZ2002 Chapter 6)&lt;/b&gt;&lt;br&gt;+ public &amp;nbsp; - private &amp;nbsp; # protected &amp;nbsp;·&amp;nbsp; &lt;u&gt;underlined&lt;/u&gt; = static &amp;nbsp;·&amp;nbsp; {abstract} (and &lt;i&gt;italic&lt;/i&gt;) = abstract&lt;br&gt;Role name and multiplicity sit at the navigable (arrow) end; a plain line is navigable both ways.&lt;br&gt;&amp;#9670; composition (whole creates its parts) &amp;nbsp;·&amp;nbsp; &amp;#9671; aggregation (parts passed in)&lt;br&gt;hollow triangle = generalisation &amp;nbsp;·&amp;nbsp; dashed hollow triangle = realisation &amp;nbsp;·&amp;nbsp; dashed arrow = dependency («use», «instantiate»)&lt;br&gt;Reference attributes are drawn as associations, not repeated in the box. Not shown: constructors (except ComboMeal's), simple getters, ConsoleUI's private display helpers, minor dependencies.&lt;br&gt;Fill: &lt;font color=&quot;#3c78d8&quot;&gt;&lt;b&gt;blue&lt;/b&gt;&lt;/font&gt; boundary · &lt;font color=&quot;#b7950b&quot;&gt;&lt;b&gt;yellow&lt;/b&gt;&lt;/font&gt; control · white entity · grey enumeration / library class" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;fontSize=10;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1710" y="1262" width="470" height="150" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;Restaurant Rush · Stage 1 class diagram&lt;/b&gt; (matches the code at tag stage-1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1710" y="1428" width="470" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>