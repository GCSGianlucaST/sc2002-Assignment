="1244" as="sourcePoint"/><mxPoint x="286" y="1244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c206" value="turn 4: Burger READY (1 unit)" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;fontFamily=Arial;fontColor=#C55A11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="1556" width="150" height="15" as="geometry"/></mxCell><mxCell id="e207" value="" style="endArrow=none;html=1;dashed=1;dashPattern=1 3;strokeColor=#E0A070;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1571" as="sourcePoint"/><mxPoint x="286" y="1571" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c208" value="turn 5: served" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;fontFamily=Arial;fontColor=#C55A11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="1655" width="150" height="15" as="geometry"/></mxCell><mxCell id="e209" value="" style="endArrow=none;html=1;dashed=1;dashPattern=1 3;strokeColor=#E0A070;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1670" as="sourcePoint"/><mxPoint x="286" y="1670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c210" value="turn 6: READY_TO_PAY" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;fontFamily=Arial;fontColor=#C55A11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="1964" width="150" height="15" as="geometry"/></mxCell><mxCell id="e211" value="" style="endArrow=none;html=1;dashed=1;dashPattern=1 3;strokeColor=#E0A070;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1979" as="sourcePoint"/><mxPoint x="286" y="1979" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c212" value="turn 7: payment" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;fontFamily=Arial;fontColor=#C55A11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="2056" width="150" height="15" as="geometry"/></mxCell><mxCell id="e213" value="" style="endArrow=none;html=1;dashed=1;dashPattern=1 3;strokeColor=#E0A070;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="2071" as="sourcePoint"/><mxPoint x="286" y="2071" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c214" value="&lt;b&gt;Use case: VIP served during Happy Hour (Stage 3)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Start:&lt;/b&gt; base setting, scripts/stage3-victory.txt; Happy Hour unused; VIP #2 arrives on turn 4.&lt;br&gt;&lt;b&gt;Manager choice:&lt;/b&gt; on turn 4 the manager answers &quot;y&quot; to Happy Hour, so the VIP's Burger is locked at $15.00 x 0.9 x 0.8 = &lt;b&gt;$10.80&lt;/b&gt; instead of $13.50, and the VIP recovers to 100 on turn 5.&lt;br&gt;&lt;b&gt;Outcome:&lt;/b&gt; the Host seats, the Waiter orders, the Chef cooks (READY), the Waiter serves (SERVED), the VIP eats (READY_TO_PAY) and the Cashier collects $10.80 at satisfaction 100; after turn 18 evaluate() returns VICTORY. Turn labels on the left show when each step happens in this run; one turn of the loop is shown, with each operand of the alt chosen on the turn noted. Omitted for readability: getters, showMessage() calls, getAvailableTasks(), markActed(), and the queue and table updates inside Restaurant.seatFromQueue()." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#B8A44C;fontSize=11;fontFamily=Arial;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="30" y="2749" width="2228" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>