@startuml stage1-object-diagram
title Object diagram (Chapter 6, Topic 4): the real objects at the end of turn 9 of scripts/victory.txt\njust before the manager's turn-10 choice in the sequence diagram
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #3B4A5A
  ArrowColor #3B4A5A
}
left to right direction
object "<u>restaurant : Restaurant</u>" as restaurant
object "<u>queue : WaitingQueue</u>" as queue
object "<u>sb : Scoreboard</u>" as sb {
  revenueCents = 2400
  servedCount = 2
  unhappyDepartures = 0
  paidSatisfactions = [84, 84]
}
restaurant --> queue : waitingQueue
restaurant --> sb : scoreboard
object "<u>table1 : Table</u>" as table1 {
  id = 1
}
restaurant --> table1 : tables
object "<u>c3 : RegularCustomer</u>" as c3 {
  id = 3
  arrivalTurn = 7
  satisfaction = 76
  status = ORDERED
}
table1 -- c3 : occupant / table
object "<u>table2 : Table</u>" as table2 {
  id = 2
}
restaurant --> table2 : tables
object "<u>o3 : Order</u>" as o3 {
  id = 3
  billCents = 1800
  unitsCompleted = 2
  status = READY
}
object "<u>pasta : MenuItem</u>" as pasta {
  name = "Pasta"
  priceCents = 1800
  preparationUnits = 2
}
restaurant --> o3 : activeOrders
c3 -- o3 : order / customer
o3 --> pasta : item
@enduml
